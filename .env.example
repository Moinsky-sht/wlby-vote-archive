# Server
NODE_ENV=production
PORT=4173

# PostgreSQL
# Example: postgresql://h5_user:strong_password@127.0.0.1:5432/h5_vote?schema=public
DATABASE_URL=postgresql://user:password@localhost:5432/h5_vote?schema=public

# Security
# Replace with a long random string before production.
APP_SECRET=replace-with-a-long-random-secret
# Keep false while serving plain HTTP. Set true after HTTPS is enabled.
COOKIE_SECURE=false
# Express trusts the first reverse proxy (Nginx). Keep this at 1 for the recommended deployment.
TRUST_PROXY=1

# Admin initialization only
# Use pnpm admin:init -- --username=beijingvote --password=replace-with-a-strong-password
ADMIN_INIT_USER=beijingvote
ADMIN_INIT_PASSWORD=replace-with-a-strong-password

# Persistent data paths
# DB_PATH is only needed while migrating existing SQLite data into PostgreSQL.
# Keep uploads on a persistent disk and back them up regularly.
DATA_DIR=/www/wwwroot/beijing-youth-vote/data
DB_PATH=/www/wwwroot/beijing-youth-vote/data/vote.sqlite
UPLOADS_DIR=/www/wwwroot/beijing-youth-vote/data/uploads

# Static assets and built frontend
ASSETS_DIR=/www/wwwroot/beijing-youth-vote/outputs/generated-component-backgrounds
CLIENT_DIR=/www/wwwroot/beijing-youth-vote/dist/client

# Local development only. Production frontend uses relative /api paths.
VITE_API_PROXY_TARGET=http://localhost:4173

# Lark CLI attachment import
# Re-authorize this identity before importing if its refresh token has expired.
LARK_ATTACHMENT_IDENTITY=user
# Identity used to read Base records; normally keep it the same as attachment identity.
LARK_RECORD_IDENTITY=user
# Comma-separated host suffixes allowed when an attachment only has a temporary URL.
LARK_ATTACHMENT_ALLOWED_HOSTS=.feishu.cn,.larksuite.com,.feishucdn.com,.larksuitecdn.com
